{
  "schemaVersion": "2.0",
  "id": "com.baijimu.connector.codex",
  "name": "Codex",
  "version": "1.2.19",
  "description": "Initialize and configure Codex, point the user-level CODEX_HOME at an isolated Baijimu workspace or restore its original value, and manage local Codex sessions.",
  "publisher": {
    "name": "Baijimu",
    "homepage": "https://baijimu.com"
  },
  "source": {
    "type": "github",
    "repo": "momoplan/baijimu-connector-codex",
    "revision": "v1.2.19"
  },
  "runtime": {
    "type": "process",
    "command": "baijimu-connector-codex",
    "args": [
      "start"
    ],
    "stopArgs": [
      "stop"
    ],
    "processOwnership": "host",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:18110/healthz",
      "timeoutSecs": 2,
      "expectStatus": 200
    }
  },
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18110",
    "auth": {
      "type": "connector_token"
    },
    "operations": {
      "setupState": {
        "method": "GET",
        "path": "/management/v1/setup/state"
      },
      "setupRetry": {
        "method": "POST",
        "path": "/management/v1/setup/retry"
      },
      "ensureCodexReady": {
        "method": "POST",
        "path": "/management/v1/setup/ensure-ready"
      },
      "credentialState": {
        "method": "GET",
        "path": "/management/v1/credential-state"
      },
      "switchAuthProfile": {
        "method": "POST",
        "path": "/management/v1/auth/switch"
      },
      "checkoutPlatformProject": {
        "method": "POST",
        "path": "/management/v1/projects/checkout"
      },
      "listCodexProjects": {
        "method": "POST",
        "path": "/management/v1/codex/projects"
      },
      "listCodexSessions": {
        "method": "POST",
        "path": "/management/v1/codex/sessions"
      },
      "readCodexSession": {
        "method": "POST",
        "path": "/management/v1/codex/sessions/read"
      },
      "startCodexSession": {
        "method": "POST",
        "path": "/management/v1/codex/sessions/start"
      },
      "listCodexTurns": {
        "method": "POST",
        "path": "/management/v1/codex/turns"
      },
      "startCodexTurn": {
        "method": "POST",
        "path": "/management/v1/codex/turns/start"
      },
      "interruptCodexTurn": {
        "method": "POST",
        "path": "/management/v1/codex/turns/interrupt"
      },
      "recentCodexEvents": {
        "method": "POST",
        "path": "/management/v1/codex/events"
      }
    }
  },
  "hostRequirements": {
    "minimumVersion": "0.2.40",
    "capabilities": [
      "connector.process.host-managed.v1"
    ]
  },
  "ui": {
    "type": "embedded",
    "entry": "ui/index.html",
    "title": "Codex 远程开发",
    "defaultView": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "port": {
        "type": "integer",
        "default": 18110,
        "minimum": 1024,
        "maximum": 65535
      },
      "codexBinary": {
        "type": "string",
        "minLength": 1,
        "description": "Advanced override only: absolute path to an official Codex CLI executable or Windows command launcher. Leave unset for automatic discovery and Connector-managed installation."
      },
      "listen": {
        "type": "string",
        "default": "stdio://"
      },
      "baijimuBinary": {
        "type": "string",
        "default": "baijimu"
      },
      "projectsDirectory": {
        "type": "string",
        "description": "Absolute directory used for canonical platform project checkouts."
      }
    },
    "additionalProperties": false
  },
  "remoteCapabilities": [
    {
      "name": "codex.project.read",
      "risk": "medium",
      "description": "Read local Codex project roots from Codex desktop state, trusted project config, and thread cwd metadata."
    },
    {
      "name": "codex.thread.read",
      "risk": "medium",
      "description": "Read, list, and search local Codex thread metadata and streamed output."
    },
    {
      "name": "codex.app.read",
      "risk": "medium",
      "description": "List Codex app-server apps/connectors visible to the local Codex account."
    },
    {
      "name": "codex.turn.write",
      "risk": "medium",
      "description": "Send prompts and steering instructions to local Codex."
    },
    {
      "name": "codex.raw.request",
      "risk": "high",
      "description": "Forward an advanced JSON-RPC request to local Codex app-server."
    },
    {
      "name": "codex.turn.interrupt",
      "risk": "medium",
      "description": "Interrupt an active Codex turn."
    }
  ],
  "transport": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18110"
  },
  "methods": [
    {
      "name": "status",
      "description": "Return connector and Codex app-server connection status.",
      "path": "/invoke/status",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "listThreads",
      "description": "List local Codex threads with cwd, source, git metadata, title, preview, and pagination.",
      "path": "/invoke/listThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listProjects",
      "description": "List local Codex projects from Codex desktop state, trusted project config, and thread cwd metadata.",
      "path": "/invoke/listProjects",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "searchTerm": {
            "type": "string"
          },
          "existsOnly": {
            "type": "boolean"
          },
          "includeSaved": {
            "type": "boolean"
          },
          "includeTrusted": {
            "type": "boolean"
          },
          "includeThreadStats": {
            "type": "boolean"
          },
          "threadCursor": {
            "type": "string"
          },
          "threadPageLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxThreadPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "archived": {
            "type": "boolean"
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listSessions",
      "description": "List local Codex sessions with cwd, source, git metadata, title, preview, and pagination.",
      "path": "/invoke/listSessions",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "searchThreads",
      "description": "Search local Codex threads by text and return matching thread metadata.",
      "path": "/invoke/searchThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "searchTerm"
        ],
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "readThread",
      "description": "Read one local Codex thread by id, optionally including turns and items.",
      "path": "/invoke/readThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "includeTurns": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listThreadTurns",
      "description": "List one page of Codex thread turns with optional full item history.",
      "path": "/invoke/listThreadTurns",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "itemsView": {
            "type": "string",
            "enum": [
              "notLoaded",
              "summary",
              "full"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listApps",
      "description": "List Codex app-server apps/connectors visible to the local Codex account.",
      "path": "/invoke/listApps",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "threadId": {
            "type": "string"
          },
          "forceRefetch": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startThread",
      "description": "Start a new Codex thread through local Codex app-server.",
      "path": "/invoke/startThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "resumeThread",
      "description": "Resume an existing Codex thread.",
      "path": "/invoke/resumeThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "excludeTurns": {
            "type": "boolean"
          },
          "initialTurnsPage": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "sortDirection": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "itemsView": {
                "type": "string",
                "enum": [
                  "notLoaded",
                  "summary",
                  "full"
                ]
              }
            },
            "additionalProperties": false
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startTurn",
      "description": "Start a Codex turn in a thread.",
      "path": "/invoke/startTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "input": {},
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "steerTurn",
      "description": "Append steering input to an active Codex turn.",
      "path": "/invoke/steerTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "input": {},
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "interruptTurn",
      "description": "Interrupt an active Codex turn.",
      "path": "/invoke/interruptTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "recentEvents",
      "description": "Read recent Codex app-server notifications cached by the connector.",
      "path": "/invoke/recentEvents",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "afterSequence": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "request",
      "description": "Forward a raw JSON-RPC request to local Codex app-server.",
      "path": "/invoke/request",
      "httpMethod": "POST",
      "timeoutSecs": 60,
      "input_schema": {
        "type": "object",
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "events": [
    {
      "name": "codexNotification",
      "description": "Notification emitted by local Codex app-server.",
      "payload_schema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ]
}
