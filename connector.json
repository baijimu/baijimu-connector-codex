{
  "schemaVersion": "3.0.0",
  "appId": "codex",
  "name": "Codex 桌面管理器",
  "version": "2.0.1",
  "description": "安装 Codex 桌面应用，管理多个隔离 Codex 工作区，并让每个工作区使用完整认证通道目录。",
  "releaseNotes": "恢复权威市场 appId codex，使现有 1.x 安装可以原地升级，并继续使用 Connector 3.0.0 与 Bridge Agent 0.6.0 的受管进程契约。",
  "publisher": {"name": "Baijimu", "homepage": "https://baijimu.com"},
  "source": {"type": "github", "repo": "baijimu/baijimu-connector-codex", "revision": "v2.0.1"},
  "runtime": {
    "type": "process",
    "command": "baijimu-codex-desktop",
    "args": ["start"],
    "stopArgs": ["stop"],
    "processOwnership": "host",
    "healthCheck": {"type": "http", "url": "http://127.0.0.1:18110/readyz", "timeoutSecs": 2, "expectStatus": 200}
  },
  "transport": {"type": "http", "baseUrl": "http://127.0.0.1:18110"},
  "methods": [
    {
      "name": "status",
      "description": "读取 Codex 桌面管理器自身的启动与健康状态；不访问 Codex CLI、任务、轮次或事件。",
      "path": "/healthz",
      "httpMethod": "GET",
      "timeoutSecs": 5,
      "input_schema": {"type": "object", "additionalProperties": false}
    }
  ],
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18110",
    "auth": {"type": "connector_token"},
    "operations": {
      "setupState": {"method": "GET", "path": "/management/v1/setup/state"},
      "setupRetry": {"method": "POST", "path": "/management/v1/setup/retry"},
      "verifyRouter": {"method": "POST", "path": "/management/v1/setup/verify-router"},
      "ensureCodexReady": {"method": "POST", "path": "/management/v1/setup/ensure-ready"},
      "credentialState": {"method": "GET", "path": "/management/v1/credential-state"},
      "initializeWorkspace": {"method": "POST", "path": "/management/v1/codex/initialize"},
      "createCodexWorkspace": {"method": "POST", "path": "/management/v1/codex/workspaces"},
      "activateCodexWorkspace": {"method": "POST", "path": "/management/v1/codex/workspaces/activate"},
      "launchCodex": {"method": "POST", "path": "/management/v1/codex/launch"},
      "switchAuthChannel": {"method": "POST", "path": "/management/v1/codex/auth-channel"},
      "restartCodex": {"method": "POST", "path": "/management/v1/codex/restart"},
      "reauthorizeWorkspace": {"method": "POST", "path": "/management/v1/codex/reauthorize"},
      "restoreExternalCodexHome": {"method": "POST", "path": "/management/v1/codex/restore-external-home"}
    }
  },
  "hostRequirements": {
    "minimumVersion": "0.6.0",
    "capabilities": ["connector.process.host-managed.v1", "connector.managed-tool-dependencies.v1"]
  },
  "managedToolDependencies": [
    {
      "id": "baijimu-cli",
      "minimumVersion": "0.1.50",
      "requiredFor": ["install", "start"],
      "executablePathEnv": "CODEX_DESKTOP_BAIJIMU_BINARY"
    }
  ],
  "ui": {"type": "embedded", "entry": "ui/index.html", "title": "Codex 桌面管理器", "defaultView": true},
  "configSchema": {
    "type": "object",
    "properties": {"port": {"type": "integer", "default": 18110, "minimum": 1024, "maximum": 65535}},
    "additionalProperties": false
  }
}
